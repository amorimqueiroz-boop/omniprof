# ANTHROPIC_API_KEY = "sk-ant-..."
# GEMINI_API_KEY = "..."
# OPENAI_API_KEY = "sk-..."
#
# Imagens:
# UNSPLASH_ACCESS_KEY = "..."  # opcional
